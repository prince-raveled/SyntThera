{
 "@context": {
  "@vocab": "https://schema.org/",
  "bioschemas": "https://bioschemas.org/",
  "broad": "https://clue.io/command?q=",
  "ncbigene": "https://www.ncbi.nlm.nih.gov/gene/"
 },
 "@type": "Dataset",
 "@id": "#exercise-mimetic-atlas",
 "name": "Exercise Mimetic Atlas: human-signature exercise-mimetic drug rankings",
 "description": "Rankings of LINCS L1000 compounds by similarity to human acute-exercise transcriptomic signatures (MoTrPAC, 175 sedentary adults; muscle, blood, adipose; endurance and resistance; difference-in-changes vs non-exercise control). Four connectivity methods including the GSFM gene-set foundation model, combined with Robust Rank Aggregation; permutation FDR; adaptive-vs-stress benefit index; rat comparison arm.",
 "version": "1.0.0",
 "dateCreated": "2026-10-13",
 "license": "https://creativecommons.org/licenses/by/4.0/",
 "creator": [
  {
   "@type": "Person",
   "name": "Jahnavi Sai G",
   "affiliation": {
    "@type": "Organization",
    "name": "SASTRA Deemed University"
   }
  },
  {
   "@type": "Person",
   "name": "Prince Kumar",
   "affiliation": {
    "@type": "Organization",
    "name": "SASTRA Deemed University"
   }
  },
  {
   "@type": "Person",
   "name": "Apurva V",
   "affiliation": {
    "@type": "Organization",
    "name": "SASTRA Deemed University"
   }
  },
  {
   "@type": "Person",
   "name": "Priyanka G",
   "affiliation": {
    "@type": "Organization",
    "name": "SASTRA Deemed University"
   }
  },
  {
   "@type": "Person",
   "name": "Vishnupriya K",
   "affiliation": {
    "@type": "Organization",
    "name": "SASTRA Deemed University"
   }
  }
 ],
 "keywords": [
  "exercise mimetics",
  "drug repurposing",
  "connectivity map",
  "LINCS L1000",
  "MoTrPAC",
  "gene set foundation model",
  "robust rank aggregation",
  "FAIR"
 ],
 "measurementTechnique": [
  "connectivity mapping",
  "robust rank aggregation",
  "permutation testing"
 ],
 "isBasedOn": [
  {
   "@type": "Dataset",
   "name": "MoTrPAC human-precovid-sed-adu c2.0 (human pre-suspension acute exercise, analysis collection)",
   "url": "https://motrpac-data.org/data-download",
   "license": "https://creativecommons.org/licenses/by/4.0/"
  },
  {
   "@type": "Dataset",
   "name": "CMap LINCS 2020 (beta), level5_beta_trt_cp",
   "url": "https://clue.io/releases/data-dashboard",
   "citation": "https://doi.org/10.1016/j.cell.2017.10.049"
  },
  {
   "@type": "Dataset",
   "name": "Drug Repurposing Hub 2020-03-24",
   "url": "https://clue.io/repurposing"
  },
  {
   "@type": "SoftwareApplication",
   "name": "GSFM",
   "url": "https://github.com/MaayanLab/gsfm",
   "identifier": "https://doi.org/10.1016/j.patter.2026.101565",
   "softwareVersion": "maayanlab/gsfm-rummagene"
  },
  {
   "@type": "Dataset",
   "name": "MoTrPAC rat endurance training (MotrpacRatTraining6moData)",
   "url": "https://github.com/MoTrPAC/MotrpacRatTraining6moData",
   "citation": "https://doi.org/10.1038/s41586-023-06877-w"
  },
  {
   "@type": "Dataset",
   "name": "MSigDB Hallmark 2020 and Reactome 2022 via Enrichr",
   "url": "https://maayanlab.cloud/Enrichr/"
  }
 ],
 "variableMeasured": [
  {
   "@type": "PropertyValue",
   "name": "rra_rho",
   "description": "Robust Rank Aggregation rho over four connectivity methods (lower = stronger exercise match)"
  },
  {
   "@type": "PropertyValue",
   "name": "rank",
   "description": "Rank among all screened compounds for one signature"
  },
  {
   "@type": "PropertyValue",
   "name": "perm_fdr",
   "description": "Benjamini-Hochberg FDR from a pooled null of random-query permutations"
  },
  {
   "@type": "PropertyValue",
   "name": "benefit",
   "description": "Adaptive-module agreement minus stress-module agreement (z units)"
  },
  {
   "@type": "PropertyValue",
   "name": "wtcs",
   "description": "CMap weighted connectivity score"
  },
  {
   "@type": "PropertyValue",
   "name": "spearman",
   "description": "Spearman correlation, landmark genes"
  },
  {
   "@type": "PropertyValue",
   "name": "xsum",
   "description": "Extreme-sum score"
  },
  {
   "@type": "PropertyValue",
   "name": "gsfm",
   "description": "GSFM embedding cosine score"
  }
 ],
 "hasPart": [
  {
   "@type": "Dataset",
   "name": "Approved endurance exercise-mimetic candidates and flagged strong matches",
   "description": "Approved drugs in the top 5% of exercise match (RRA across informative signatures). Candidates exclude cytotoxic/generic-stress mechanisms and drugs profiled in fewer than 3 cell lines, and are ranked by mean benefit index.",
